<?xml version="1.0" encoding="UTF-8"?>
<!-- Compact terminal layout for Kindle: rows 10 key widths wide, text labels only.
     The symbol key is one-shot: it switches the next key to its mod1 variant.
     Row heights are thousandths of an ordinary row: the three rows of letters,
     tapped most, are taller; the special keys and the numbers, shorter. -->
<keyboard>
  <layout id="kindle compact">
    <row height="875">
      <key>
        <default display="Esc" action="escape" />
      </key>
      <key>
        <default display="Ctrl" action="modifier:ctrl" />
      </key>
      <key>
        <default display="Tab" action="tab" />
      </key>
      <key>
        <default display="-" />
        <shifted display="_" />
        <mod1 display="_" />
      </key>
      <key>
        <default display="/" />
        <shifted display="?" />
        <mod1 display="\" />
      </key>
      <key>
        <default display="|" />
        <shifted display="\" />
        <mod1 display="~" />
      </key>
      <key>
        <default display="↑" action="up" />
        <mod1 display="PgUp" action="pageup" />
      </key>
      <key>
        <default display="↓" action="down" />
        <mod1 display="PgDn" action="pagedown" />
      </key>
      <key>
        <default display="←" action="left" />
        <mod1 display="Home" action="home" />
      </key>
      <key>
        <default display="→" action="right" />
        <mod1 display="End" action="end" />
      </key>
    </row>
    <row height="875">
      <key>
        <default display="1" />
        <shifted display="!" />
        <mod1 display="F1" action="f1" />
      </key>
      <key>
        <default display="2" />
        <shifted display="@" />
        <mod1 display="F2" action="f2" />
      </key>
      <key>
        <default display="3" />
        <shifted display="#" />
        <mod1 display="F3" action="f3" />
      </key>
      <key>
        <default display="4" />
        <shifted display="$" />
        <mod1 display="F4" action="f4" />
      </key>
      <key>
        <default display="5" />
        <shifted display="%" />
        <mod1 display="F5" action="f5" />
      </key>
      <key>
        <default display="6" />
        <shifted display="^" />
        <mod1 display="F6" action="f6" />
      </key>
      <key>
        <default display="7" />
        <shifted display="&amp;" />
        <mod1 display="F7" action="f7" />
      </key>
      <key>
        <default display="8" />
        <shifted display="*" />
        <mod1 display="F8" action="f8" />
      </key>
      <key>
        <default display="9" />
        <shifted display="(" />
        <mod1 display="F9" action="f9" />
      </key>
      <key>
        <default display="0" />
        <shifted display=")" />
        <mod1 display="F10" action="f10" />
      </key>
    </row>
    <row height="1200">
      <key obey-caps="true">
        <default display="q" />
        <shifted display="Q" />
        <mod1 display="`" />
      </key>
      <key obey-caps="true">
        <default display="w" />
        <shifted display="W" />
        <mod1 display="@" />
      </key>
      <key obey-caps="true">
        <default display="e" />
        <shifted display="E" />
        <mod1 display="=" />
      </key>
      <key obey-caps="true">
        <default display="r" />
        <shifted display="R" />
        <mod1 display="+" />
      </key>
      <key obey-caps="true">
        <default display="t" />
        <shifted display="T" />
        <mod1 display="[" />
      </key>
      <key obey-caps="true">
        <default display="y" />
        <shifted display="Y" />
        <mod1 display="]" />
      </key>
      <key obey-caps="true">
        <default display="u" />
        <shifted display="U" />
        <mod1 display="{" />
      </key>
      <key obey-caps="true">
        <default display="i" />
        <shifted display="I" />
        <mod1 display="}" />
      </key>
      <key obey-caps="true">
        <default display="o" />
        <shifted display="O" />
        <mod1 display="&lt;" />
      </key>
      <key obey-caps="true">
        <default display="p" />
        <shifted display="P" />
        <mod1 display="&gt;" />
      </key>
    </row>
    <row height="1200">
      <space width="500" />
      <key obey-caps="true">
        <default display="a" />
        <shifted display="A" />
        <mod1 display="'" />
      </key>
      <key obey-caps="true">
        <default display="s" />
        <shifted display="S" />
        <mod1 display='"' />
      </key>
      <key obey-caps="true">
        <default display="d" />
        <shifted display="D" />
        <mod1 display="#" />
      </key>
      <key obey-caps="true">
        <default display="f" />
        <shifted display="F" />
        <mod1 display="%" />
      </key>
      <key obey-caps="true">
        <default display="g" />
        <shifted display="G" />
        <mod1 display="^" />
      </key>
      <key obey-caps="true">
        <default display="h" />
        <shifted display="H" />
        <mod1 display="\" />
      </key>
      <key obey-caps="true">
        <default display="j" />
        <shifted display="J" />
        <mod1 display="?" />
      </key>
      <key obey-caps="true">
        <default display="k" />
        <shifted display="K" />
        <mod1 display="(" />
      </key>
      <key obey-caps="true">
        <default display="l" />
        <shifted display="L" />
        <mod1 display=")" />
      </key>
      <space width="500" />
    </row>
    <row height="1200">
      <key width="1500">
        <default display="Shift" action="modifier:shift" />
      </key>
      <key obey-caps="true">
        <default display="z" />
        <shifted display="Z" />
        <mod1 display="F11" action="f11" />
      </key>
      <key obey-caps="true">
        <default display="x" />
        <shifted display="X" />
        <mod1 display="F12" action="f12" />
      </key>
      <key obey-caps="true">
        <default display="c" />
        <shifted display="C" />
        <mod1 display="|" />
      </key>
      <key obey-caps="true">
        <default display="v" />
        <shifted display="V" />
        <mod1 display="!" />
      </key>
      <key obey-caps="true">
        <default display="b" />
        <shifted display="B" />
        <mod1 display="$" />
      </key>
      <key obey-caps="true">
        <default display="n" />
        <shifted display="N" />
        <mod1 display="&amp;" />
      </key>
      <key obey-caps="true">
        <default display="m" />
        <shifted display="M" />
        <mod1 display="*" />
      </key>
      <key width="1500">
        <default display="⌫" action="backspace" />
        <mod1 display="Del" action="delete" />
      </key>
    </row>
    <row height="1000">
      <key>
        <default display="符" action="modifier:mod1" />
      </key>
      <key>
        <default display="Alt" action="modifier:alt" />
      </key>
      <key>
        <default display="中" action="ime" />
      </key>
      <key>
        <default display="," />
        <shifted display="&lt;" />
        <mod1 display=";" />
      </key>
      <key width="3000">
        <default display=" " action="space" />
      </key>
      <key>
        <default display="." />
        <shifted display="&gt;" />
        <mod1 display=":" />
      </key>
      <key width="2000">
        <default display="Enter" action="return" />
      </key>
    </row>
  </layout>
</keyboard>
